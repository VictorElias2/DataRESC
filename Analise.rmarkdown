### Transfere dados para SQLITE



```{r}

library(RSQLite)
dados <-  read_xlsx("../dados/base-escolas-simet-2025-08-22.xlsx")
conn <- dbConnect(SQLite(), "../analise-auditoria/dados/dados.sqlite")
dbWriteTable(con, "dados", dados)

```



## Gráficos

#### Mátriculas por região



```{r}

library(ggplot2)

temp <- dbGetQuery(conn, "SELECT nm_regiao, sum(escolar_qtematriculas) as matriculas
                              from dados GROUP by nm_regiao;")
temp %>% 
    ggplot(aes(x = temp$nm_regiao, y = temp$matriculas)) +
    geom_col()
```



